# ==============================================================================
# FoodFlow — Environment Configuration Reference (.env.example)
# Copy this file to .env and customize values for your deployment environment.
# NEVER commit your actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production, DEBUG must ALWAYS be False.
DEBUG=True

# Cryptographically random key. Required when DEBUG=False.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-cryptographically-random-string-at-least-50-characters

# Comma-separated list of hostnames or domains this Django site can serve.
ALLOWED_HOSTS=127.0.0.1,localhost,foodflow.org,food-flow-web.vercel.app

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Standard PostgreSQL URL. When omitted in local development, SQLite (db.sqlite3) is used.
# Production deployments on Vercel/Render/Fly.io require a persistent PostgreSQL URL (e.g. Neon).
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgres://foodflow_user:secure_password@ep-sample-123456.us-east-2.aws.neon.tech/foodflow?sslmode=require

# ------------------------------------------------------------------------------
# 3. SECURITY & NETWORKING (Production HTTPS)
# ------------------------------------------------------------------------------
# Enable SSL redirect in production (default: True when DEBUG=False)
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security duration in seconds (default: 31536000 = 1 year)
SECURE_HSTS_SECONDS=31536000

# Comma-separated list of trusted origins for CSRF validation (e.g. https://*.yourdomain.com)
CSRF_TRUSTED_ORIGINS=https://food-flow-web.vercel.app,http://127.0.0.1:8000,http://localhost:8000

# Session backend (default: django.contrib.sessions.backends.db)
DJANGO_SESSION_ENGINE=django.contrib.sessions.backends.db

# ------------------------------------------------------------------------------
# 4. MEDIA & FILE STORAGE
# ------------------------------------------------------------------------------
# Set to True only for containerized staging deployments without an Nginx reverse proxy.
# Note: For serverless platforms like Vercel, configure an external cloud storage provider (e.g. S3).
SERVE_MEDIA_IN_PROD=False

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# Default in development: console backend (prints emails to stdout)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@foodflow.org

# For production SMTP delivery (e.g. SendGrid, Mailgun, Amazon SES):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_production_api_key_here

# ------------------------------------------------------------------------------
# 6. SCHEDULED MAINTENANCE COMMANDS (CRON)
# ------------------------------------------------------------------------------
# Run every 15-30 minutes on your production server or scheduler:
# python manage.py expiry_sweep
